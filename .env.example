# ============================================================================
# ClimateGuard AI — Environment Variables
# ============================================================================
# Copy this file to .env.local and fill in your credentials.
# Without Supabase credentials the app runs in demo mode (dashboard accessible,
# auth forms show a demo mode banner, weather data loads from Open-Meteo).
# ============================================================================

# Supabase Configuration (required for authentication and database persistence)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# MapLibre Basemap — uses free CartoDB Dark Matter by default (no key needed)
# Replace with MapTiler or Mapbox style URL for higher-quality tiles
NEXT_PUBLIC_MAPLIBRE_STYLE=https://basemaps.cartocdn.com/gl/dark-matter-gl-style/style.json

# Open-Meteo (completely free, no API key required)
OPEN_METEO_API_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_FLOOD_URL=https://flood-api.open-meteo.com/v1/flood
OPEN_METEO_ARCHIVE_URL=https://archive-api.open-meteo.com/v1/archive

# OpenAI narrative briefings (optional). Deterministic analysis works without this.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# NASA FIRMS active-fire pixels (optional). Register a MAP_KEY; do not use NEXT_PUBLIC.
NASA_FIRMS_MAP_KEY=

# Copernicus CDS (optional, not called by the web app). See scripts/ingest/copernicus_cds.py
CDSAPI_URL=https://cds.climate.copernicus.eu/api
CDSAPI_KEY=

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
